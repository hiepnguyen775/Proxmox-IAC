# roles/monitoring/templates/prometheus.yml.j2
# Managed by Ansible — do not edit manually

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'proxmox-lab'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # node_exporter trên TẤT CẢ VM (cổng 9100)
  - job_name: 'node'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host]["ansible_host"] }}:9100']
        labels:
          host: '{{ host }}'
{% endfor %}

  # ----------------------------------------------------------------
  # Scrape metrics CỦA Kubernetes (kubelet/apiserver) KHÔNG làm kiểu
  # static được: cổng 10250 cần HTTPS + bearer token. Cách đúng là
  # deploy kube-prometheus-stack BÊN TRONG cluster bằng Helm.
  # Xem docs/05-nang-cao.md mục "Giám sát Kubernetes".
  # ----------------------------------------------------------------
