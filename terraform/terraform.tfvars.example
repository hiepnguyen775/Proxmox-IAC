# =============================================
#  terraform.tfvars.example
#  Copy thành terraform.tfvars và điền thực
#  KHÔNG commit file này lên git!
# =============================================

proxmox_endpoint  = "https://192.168.1.10:8006"
proxmox_api_token = "terraform@pve!tf-token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true
proxmox_ssh_user  = "root"

proxmox_nodes = {
  "pve-node-01" = "192.168.1.10"
  "pve-node-02" = "192.168.1.11"
  "pve-node-03" = "192.168.1.12"
}

vm_template_id    = 9000
vm_ssh_public_key = "ssh-ed25519 AAAA... your-key-here" # nội dung ~/.ssh/id_ed25519.pub
vm_default_user   = "ubuntu"
vm_dns_server     = "1.1.1.1"
vm_dns_domain     = "lab.local"

storage_vm_pool  = "local-lvm"   # hoặc "ceph-vm" sau khi Ceph setup
storage_iso_pool = "local"

vm_bridge         = "vmbr0"
vm_gateway        = "192.168.1.1"
vm_network_prefix = "24"

# ---------- VM DEFINITIONS ----------
vm_definitions = {
  "k8s-master-01" = {
    vm_id      = 101
    node       = "pve-node-01"
    cpu_cores  = 4
    memory_mb  = 8192
    disk_gb    = 50
    ip_address = "192.168.1.101/24"
    tags       = ["k8s", "k8s-master", "prod"]
  }
  "k8s-worker-01" = {
    vm_id      = 111
    node       = "pve-node-01"
    cpu_cores  = 4
    memory_mb  = 8192
    disk_gb    = 80
    ip_address = "192.168.1.111/24"
    tags       = ["k8s", "k8s-worker", "prod"]
  }
  "k8s-worker-02" = {
    vm_id      = 112
    node       = "pve-node-02"
    cpu_cores  = 4
    memory_mb  = 8192
    disk_gb    = 80
    ip_address = "192.168.1.112/24"
    tags       = ["k8s", "k8s-worker", "prod"]
  }
  "k8s-worker-03" = {
    vm_id      = 113
    node       = "pve-node-03"
    cpu_cores  = 4
    memory_mb  = 8192
    disk_gb    = 80
    ip_address = "192.168.1.113/24"
    tags       = ["k8s", "k8s-worker", "prod"]
  }
  "monitoring-01" = {
    vm_id      = 120
    node       = "pve-node-01"
    cpu_cores  = 2
    memory_mb  = 4096
    disk_gb    = 60
    ip_address = "192.168.1.120/24"
    tags       = ["monitoring", "prometheus", "grafana"]
  }
}

# ---------- LXC DEFINITIONS ----------
lxc_definitions = {
  "proxy-01" = {
    ct_id       = 200
    node        = "pve-node-01"
    cpu_cores   = 1
    memory_mb   = 512
    disk_gb     = 8
    ip_address  = "192.168.1.200/24"
    tags        = ["proxy", "nginx"]
    os_template = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
  }
}

# ---------- CEPH ----------
ceph_enabled         = false
ceph_network         = "192.168.1.0/24"
ceph_cluster_network = "10.10.10.0/24"

# ---------- SDN ----------
sdn_enabled = false
sdn_zones = []
